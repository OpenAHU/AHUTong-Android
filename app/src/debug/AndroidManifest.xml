<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ADB shell/root only; absent from release. No network listener or user Key. -->
        <provider
            android:name="com.ahu.ahutong.cli.CliProvider"
            android:authorities="${applicationId}.cli"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug-only shell-launchable host for UI tests; no account or startup flows. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@style/Theme.AHUTong" />
    </application>
</manifest>
