<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- The bundled Rust bridge listens only on the app-local loopback socket. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- 金寨路校区一卡通上游（ykt.hfue.edu.cn:8020）只提供明文 HTTP；插件与宿主同进程，
         共用这份网络策略，插件访问余额/流水/电费接口前必须在此放行。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ykt.hfue.edu.cn</domain>
    </domain-config>
</network-security-config>
