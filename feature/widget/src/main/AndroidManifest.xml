<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.ahu.ahutong.appwidget.ScheduleAppWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:exported="false"
            android:label="课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_widget_info" />
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetTransitionAnimation"
                android:value="false" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="20000" />
        </receiver>

        <receiver
            android:name="com.ahu.ahutong.appwidget.ScheduleAdaptiveWidgetProvider"
            android:exported="false"
            android:label="课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/adaptive_test_widget_info" />
        </receiver>

        <receiver
            android:name="com.ahu.ahutong.appwidget.WidgetUpdateScheduler"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ahu.ahutong.appwidget.ACTION_UPDATE_WIDGETS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
